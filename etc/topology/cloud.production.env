# cloud.production topology profile for sdkwork-missory.
# Source-controlled template; real secrets never live here (ENVIRONMENT_SPEC.md).

SDKWORK_MISSORY_REGION_CODE=cn
SDKWORK_MISSORY_DEPLOYMENT_PROFILE=cloud
SDKWORK_MISSORY_ENVIRONMENT=production
SDKWORK_MISSORY_PROFILE_ID=cloud.production
SDKWORK_MISSORY_RUNTIME_TARGET=container
SDKWORK_MISSORY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8474
SDKWORK_MISSORY_APPLICATION_PUBLIC_HTTP_URL=https://missory.sdkwork.com
SDKWORK_MISSORY_SNOWFLAKE_NODE_ID=1

# IAM identity plane (ADR-20261002): production provisions these per deployment;
# real secrets never live in source control (ENVIRONMENT_SPEC.md).
# Required by the IAM production hardening assertion (startup refuses without it):
# SDKWORK_IAM_SIGNING_MASTER_SECRET=<deployed secret>
# Credential-entry bootstrap Access-Token for deployed client surfaces
# (browser runtime-env authBootstrapAccessToken / Flutter dart-define /
# mini-program runtime-env key):
# SDKWORK_MISSORY_AUTH_BOOTSTRAP_ACCESS_TOKEN=<deployed token>
