# standalone.development topology profile for sdkwork-missory.
# Source-controlled template; real secrets never live here (ENVIRONMENT_SPEC.md).

SDKWORK_MISSORY_REGION_CODE=cn
SDKWORK_MISSORY_DEPLOYMENT_PROFILE=standalone
SDKWORK_MISSORY_ENVIRONMENT=development
SDKWORK_MISSORY_PROFILE_ID=standalone.development
SDKWORK_MISSORY_RUNTIME_TARGET=container
SDKWORK_MISSORY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8460
SDKWORK_MISSORY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8460
SDKWORK_MISSORY_SNOWFLAKE_NODE_ID=1

# Development-only identity bypass; MUST stay unset in non-development profiles.
SDKWORK_MISSORY_DEV_AUTH_BYPASS=true
# Shared browser-origin allowlist (CORS_SPEC.md section 5): dev servers + client origins.
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3910,http://localhost:3910,http://127.0.0.1:5197,http://localhost:5197,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com

# Browser development binds (CORS loopback origins derive from these; CORS_SPEC.md section 4).
SDKWORK_MISSORY_PC_WEB_DEV_INGRESS_BIND=127.0.0.1:3910
SDKWORK_MISSORY_H5_WEB_DEV_INGRESS_BIND=127.0.0.1:5197
