<view class="page">
  <view class="card">
    <view class="card-title">问我任何关于你人际关系的问题</view>
    <input value="{{question}}" bindinput="onQuestion" placeholder="李明是谁？" />
    <view class="button" bindtap="ask" style="margin-top: 12rpx;">发送</view>
    <view wx:if="{{answer}}" style="margin-top: 16rpx; white-space: pre-wrap;">{{answer}}</view>
  </view>
  <view class="card">
    <view class="card-title">消息草稿（仅草稿，不会自动发送）</view>
    <input value="{{personId}}" bindinput="onPersonId" placeholder="人物 ID" />
    <view class="button" bindtap="draft" style="margin-top: 12rpx;">生成生日祝福草稿</view>
    <view wx:if="{{draft}}" style="margin-top: 16rpx; white-space: pre-wrap;">{{draft}}</view>
  </view>
  <view class="card">
    <view class="card-title">聊天记录总结</view>
    <input value="{{chatPersonId}}" bindinput="onChatPersonId" placeholder="人物 ID" />
    <textarea value="{{chatText}}" bindinput="onChatText" placeholder="粘贴与 TA 的聊天记录…" style="width: 100%; min-height: 160rpx; margin-top: 12rpx;" />
    <view class="button" bindtap="summarizeChat" style="margin-top: 12rpx;">生成聊天总结</view>
    <view wx:if="{{chatSummary}}" style="margin-top: 16rpx;">
      <view style="white-space: pre-wrap;">{{chatSummary.summary}}</view>
      <view class="card-title" style="margin-top: 16rpx;">候选记忆（只读）</view>
      <view wx:for="{{chatSummary.candidates}}" wx:key="id" class="row">
        <view style="flex: 1;"><text class="badge">{{item.type}}</text>{{item.content}}</view>
      </view>
      <view wx:if="{{chatSummary.candidates.length === 0}}" class="muted">没有提取到候选记忆</view>
      <view class="muted" style="margin-top: 12rpx;">候选记忆已保存为待确认状态，可在记忆页确认或拒绝。</view>
    </view>
  </view>
</view>
