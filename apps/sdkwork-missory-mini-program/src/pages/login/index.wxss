.login {
  display: flex;
  flex-direction: column;
  padding: 48rpx 40rpx;
  gap: 24rpx;
}
.login-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.login-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.login-label {
  font-size: 26rpx;
  color: #475569;
}
.login-input {
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.login-error {
  color: #dc2626;
  font-size: 26rpx;
}
.login-submit {
  margin-top: 16rpx;
}
