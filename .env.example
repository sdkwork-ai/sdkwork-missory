# SDKWork Missory local development environment example.
# Copy to `.env` (git-ignored) and adjust. Real secrets never go into git.

# Required for server startup (fail-closed): development|test|staging|demo|production
SDKWORK_MISSORY_ENVIRONMENT=development
SDKWORK_MISSORY_DEPLOYMENT_PROFILE=standalone
SDKWORK_MISSORY_PROFILE_ID=standalone.development
SDKWORK_MISSORY_RUNTIME_TARGET=container

# Standalone gateway bind address.
SDKWORK_MISSORY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8460
SDKWORK_MISSORY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8460

# Snowflake-style id generator node id (per-instance unique).
SDKWORK_MISSORY_SNOWFLAKE_NODE_ID=1

# Optional: pluggable language model provider for the social agent.
# When unset, the deterministic rule-based assistant is used.
# SDKWORK_MISSORY_LLM_PROVIDER=openai
# SDKWORK_MISSORY_LLM_API_KEY=
# SDKWORK_MISSORY_LLM_MODEL=gpt-4o-mini

# Region dimension (REGION_SPEC.md).
SDKWORK_MISSORY_REGION_CODE=cn

# Development-only identity bypass: injects the default owner context when no
# identity headers are present. MUST stay unset outside development.
SDKWORK_MISSORY_DEV_AUTH_BYPASS=true

# Shared browser-origin allowlist (CORS_SPEC.md section 5).
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3910,http://127.0.0.1:5197,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
