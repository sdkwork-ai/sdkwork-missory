{
  "$schema": "../sdkwork-github-workflow/schemas/agent-workflow.schema.json",
  "schemaVersion": "2026-06-06.agent.workflow.v1",
  "app": {
    "id": "sdkwork-missory",
    "name": "SDKWork Missory",
    "repository": "sdkwork-ai/sdkwork-missory",
    "sourcePath": ".",
    "configPath": "agent.app.config.json"
  },
  "release": {
    "artifactPrefix": "sdkwork-missory",
    "defaultVersion": "0.1.0",
    "changelog": {
      "source": "app-manifest",
      "maxCommitSubjects": 50
    }
  },
  "dependencies": [
    {
      "id": "sdkwork-utils",
      "repository": "sdkwork-ai/sdkwork-utils",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-app-topology",
      "repository": "sdkwork-ai/sdkwork-app-topology",
      "refInput": "SDKWORK_APP_TOPOLOGY_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "sdkwork-ai/sdkwork-web-framework",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "sdkwork-ai/sdkwork-database",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "sdkwork-ai/sdkwork-iam",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-generator",
      "repository": "sdkwork-ai/sdkwork-sdk-generator",
      "refInput": "SDKWORK_SDK_GENERATOR_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-id",
      "repository": "sdkwork-ai/sdkwork-id",
      "refInput": "SDKWORK_ID_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-commons",
      "repository": "sdkwork-ai/sdkwork-sdk-commons",
      "refInput": "SDKWORK_SDK_COMMONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "toolchains": {
    "rust": "[object Object]",
    "node": "[object Object]",
    "flutter": "[object Object]",
    "pnpm": "[object Object]"
  },
  "lifecycle": {
    "build": [
      {
        "name": "server",
        "run": "pnpm build",
        "workingDirectory": "."
      },
      {
        "name": "pc",
        "run": "pnpm build:pc:prod",
        "workingDirectory": "."
      },
      {
        "name": "h5",
        "run": "pnpm build:h5:prod",
        "workingDirectory": "."
      },
      {
        "name": "mini-program",
        "run": "pnpm build:mini-program",
        "workingDirectory": "."
      },
      {
        "name": "flutter-android",
        "run": "pnpm check:flutter",
        "workingDirectory": "."
      }
    ]
  },
  "targets": [
    {
      "id": "container-x64-standalone-container-oci",
      "packageId": "container-x64-standalone-container-oci",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "container",
      "profile": "container",
      "platform": "container",
      "architecture": "x64",
      "formats": [
        "oci"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/container/*.tar"
      ]
    },
    {
      "id": "container-x64-cloud-container-oci",
      "packageId": "container-x64-cloud-container-oci",
      "profileBinding": "fixed",
      "deploymentProfile": "cloud",
      "runtimeTarget": "container",
      "profile": "container",
      "platform": "container",
      "architecture": "x64",
      "formats": [
        "oci"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/container/*.tar"
      ]
    }
  ],
  "security": {},
  "publish": {}
}
