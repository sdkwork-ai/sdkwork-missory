# SDKWork Missory gitignore — aligned with REPOSITORY_BASELINE_SPEC.md section 2
# and sdkwork-memory / sdkwork-notes fleet practice.

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs and local diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and secret-bearing overrides
.env
.env.*
!.env.example
!.env.*.example
*.local
*.local.*

# SDKWork local workspace state
.sdkwork/local/
.sdkwork/tmp/
.sdkwork/cache/
.sdkwork/secrets/
.sdkwork/manual-backups/

# Dependencies and build outputs
node_modules/
target/
dist/
build/
coverage/
deployments/artifacts/
!deployments/artifacts/.gitkeep

# SDKWork local runtime state
.runtime/
**/.runtime/
**/node_modules/
/target/
**/target/
**/dist/
**/.pnpm-store/
**/.sdkwork/local/
**/.sdkwork/secrets/
**/.sdkwork/cache/
**/.sdkwork/tmp/
**/.sdkwork/manual-backups/

# Compiled sourcemaps (never commit generated maps)
*.js.map
*.d.ts.map

# Local scratch and build residue (do not commit)
tmp/
.tmp/
.tmp_*

# Python bytecode (do not commit)
__pycache__/

# Local assistant state (do not commit)
.workbuddy/

# Compiler emit beside authored TypeScript is enforced against tracked files by
# sdkwork-specs/tools/check-repository-baseline-content.mjs instead of broad globs,
# so no `**/src/**/*.js` style ignore rules appear here.

# --- Client app surfaces: local build/runtime artifacts (never commit) ---
apps/*/public/runtime-env.json
apps/*/.env
apps/*/.env.*
!apps/*/.env.example
apps/*/dist/
**/dist/
apps/sdkwork-missory-flutter-mobile/.dart_tool/
apps/sdkwork-missory-flutter-mobile/build/
apps/sdkwork-missory-flutter-mobile/android/.gradle/
apps/sdkwork-missory-flutter-mobile/android/local.properties
apps/sdkwork-missory-flutter-mobile/ios/Pods/
apps/sdkwork-missory-flutter-mobile/ios/Flutter/ephemeral/
apps/sdkwork-missory-flutter-mobile/ios/Flutter/flutter_export_environment.sh
apps/sdkwork-missory-flutter-mobile/*.iml
apps/sdkwork-missory-mini-program/src/runtime/*.js
# Flutter analyze residue inside the generator-owned Dart SDK tree
sdks/sdkwork-missory-app-sdk/sdkwork-missory-app-sdk-dart/generated/server-openapi/.dart_tool/
sdks/sdkwork-missory-app-sdk/sdkwork-missory-app-sdk-dart/generated/server-openapi/pubspec.lock
# Local GUI-regression evidence (not repo content)
gui-test-screenshots/
